# Apache configuration for the reconstructed shell.
# Equivalent of router.php for deployments without `php -S`.

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block internals (config, PHP sources, SQL, CLI helpers, tests).
  RewriteRule ^(config|sql|bin|tests)(/|$) - [F,L]
  RewriteRule ^api/src(/|$) - [F,L]

  # Original merchant contract + backend API -> front controller.
  RewriteRule ^(api|wps)/ api/index.php [L,QSA]
</IfModule>

<FilesMatch "\.(php|sql|md|log|sh|example\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# The front controller itself must stay reachable.
<Files "index.php">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
</IfModule>

# Cache policy mirroring the WebView interceptor: only .json is cached aggressively.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
